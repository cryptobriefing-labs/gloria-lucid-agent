# Agent metadata
AGENT_NAME=Gloria
AGENT_DESCRIPTION=AI-powered crypto news intelligence. Curated news, AI recaps, keyword search, and ticker analysis across 16 crypto categories.
AGENT_VERSION=1.0.0
PORT=3004

# x402 payment configuration
PAYMENTS_FACILITATOR_URL=https://facilitator.daydreams.systems
PAYMENTS_NETWORK=base
PAYMENTS_RECEIVABLE_ADDRESS=0x...your_wallet_address

# Entrypoint prices (in USDC, e.g. "0.001" = $0.001)
PRICE_NEWS=0.001
PRICE_RECAP=0.001
PRICE_SEARCH=0.001
PRICE_TICKER_SUMMARY=0.01

# Gloria backend API
GLORIA_API_URL=https://ai-hub.cryptobriefing.com
GLORIA_API_TOKEN_DEV=your_api_token
